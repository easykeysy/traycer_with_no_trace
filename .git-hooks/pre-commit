#!/usr/bin/env bash
# Pre-commit hook: LAW-1 (no agentic footer) + LAW-10 (binding-docs sub-repo
# clean) + LAW-11 (no hybrid files) + LAW-13 (no intermediates) + LAW-14 (no
# credentials) + LAW-16 (English-only). Canonical copy lives in .git-hooks/
# (tracked by git); see binding-docs/LAW.md; LAW-12 covers clone resurrection.
set -euo pipefail

fail() { echo "pre-commit: $*" >&2; exit 1; }

# ---------- Gate 1: LAW-1 - no agentic footers in this commit ----------
MSG_FILE="$(git rev-parse --git-path COMMIT_EDITMSG 2>/dev/null || echo .git/COMMIT_EDITMSG)"
if [ -f "$MSG_FILE" ]; then
  if grep -qE 'Generated with|Co-Authored-By:' "$MSG_FILE"; then
    fail "LAW-1: commit message contains an agentic footer. Remove it and re-stage."
  fi
fi
if git diff --cached -U0 | grep -qE '^\+[[:space:]]*(\*\*)?Generated with' || \
   git diff --cached -U0 | grep -qE '^\+[[:space:]]*(\*\*)?Co-Authored-By:'; then
  fail "LAW-1: staged diff adds an agentic footer line. Remove it and re-stage."
fi

# ---------- Gate 2: LAW-10 - binding-docs sub-repo must be clean ----------
BINDING_DIR="binding-docs"
if [ -d "$BINDING_DIR" ]; then
  if [ -n "$(git -C "$BINDING_DIR" status --porcelain)" ]; then
    fail "LAW-10: $BINDING_DIR has uncommitted changes. Commit in the sub-repo first, then retry the parent commit."
  fi
  if ! git -C "$BINDING_DIR" log -1 --format=%H >/dev/null 2>&1; then
    fail "LAW-10: $BINDING_DIR sub-repo has no commits yet. Make the initial binding commit first."
  fi
fi

# ---------- Gate 3: LAW-4 - pinned-base assertion drift (advisory only) ----------
if [ -f "binding-docs/AGENTS.md" ] && [ -f ".git-hooks/upstream-base.manifest" ]; then
  pinned="$(sed -n 's/.*pinned base: upstream [^ ]* = \([0-9a-f]\{40\}\).*/\1/p' .git-hooks/upstream-base.manifest | head -n 1)"
  if [ -n "$pinned" ] && ! grep -q "$pinned" binding-docs/AGENTS.md; then
    echo "pre-commit: NOTE: binding-docs/AGENTS.md does not mention the pinned base $pinned; per LAW-4 the measured SHA wins. Update the doc." >&2
  fi
fi

# ---------- Gate 4: LAW-14 - no credentials in the staged tree ----------
# Catch credential-shaped content being *added*: sk- prefixed keys,
# user:pass@ DSNs, PEM private-key headers, client_secret assignments.
# .example templates with $PLACEHOLDERS are allowed.
if git diff --cached -U0 | grep -qE '^\+(.)*(sk-[A-Za-z0-9]{20,}|(postgres|mysql|mongodb|redis)://[^/ ]+:[^/ ]+@|BEGIN [A-Z ]*PRIVATE KEY|client_secret\s*[:=]\s*\S+)' && \
   ! [ -f ".git-hooks/.gate4-allow" ]; then
  fail "LAW-14: staged diff adds credential-shaped content. Move the real value to a machine-private store and keep only placeholders in-tree."
fi

# ---------- Gate 5: LAW-13 - no build/test/runtime intermediates in tree ----------
# Reject any staged *new* file whose path matches intermediate-artifact
# patterns. The pattern list is a one-line literal in this hook; it never
# appears as an added file path, so this gate cannot trip on its own text.
if git diff --cached -U0 --name-status | awk '$1=="A" {print $2}' | \
   grep -qE '\.(pyc|pyo|log|tmp|bak|orig|db)$|__pycache__|^target/|^dist/|^build/|^node_modules/|^\.gradle/|^\.idea/|^data/|^prototype/'; then
  fail "LAW-13: staged diff adds build/test/runtime intermediate artifacts. Add the pattern to .gitignore and unstage the file."
fi

# ---------- Gate 6: LAW-11 - no hybrid files (upstream base untouched) ----------
# .git-hooks/upstream-base.manifest lists every path in the pinned upstream
# base as "<base-blob-sha>\t<path>"; .git-hooks/wiring-allowlist lists the
# grandfathered paths allowed to diverge (the no-account rewrite). A staged
# change that lands an upstream file at a blob different from its base blob
# is rejected unless the path is allowlisted. Restoring the exact base blob
# is always allowed.
MANIFEST=".git-hooks/upstream-base.manifest"
ALLOWLIST=".git-hooks/wiring-allowlist"
if [ -f "$MANIFEST" ] && [ -f "$ALLOWLIST" ]; then
  LAW11_BAD=""
  while IFS=$'\t' read -r st path; do
    [ -n "$path" ] || continue
    base_sha="$(awk -F '\t' -v p="$path" '$1 ~ /^#/ {next} $2 == p {print $1; exit}' "$MANIFEST")"
    [ -n "$base_sha" ] || continue
    if [ "$st" = "D" ]; then
      cur="deleted"
    else
      cur="$(git ls-files -s -- "$path" | awk '{print $2}')"
    fi
    if [ "$cur" != "$base_sha" ] && ! grep -qxF -- "$path" "$ALLOWLIST"; then
      LAW11_BAD="$LAW11_BAD  $path"$'\n'
    fi
  done < <(git diff --cached --no-renames --name-status --diff-filter=AMD)
  if [ -n "$LAW11_BAD" ]; then
    fail "LAW-11: staged change alters upstream base file(s) outside the wiring allowlist:
$LAW11_BAD Fork work must go in new standalone files (LAW-11); allowlist changes need maintainer sign-off."
  fi
fi

# ---------- Gate 7: LAW-16 - English-only (no CJK in staged added lines) ----------
if command -v python3 >/dev/null 2>&1; then
  PY=python3
elif command -v python >/dev/null 2>&1; then
  PY=python
else
  echo "pre-commit: WARNING: python not found; the LAW-16 CJK gate is skipped this run." >&2
  PY=""
fi
if [ -n "$PY" ]; then
  ROOT_HOOK="$(git rev-parse --show-toplevel)"
  set +e
  "$PY" -B "$ROOT_HOOK/.git-hooks/check_no_new_cjk.py"
  rc=$?
  set -e
  case "$rc" in
    0) ;;
    1) fail "LAW-16: CJK/non-English text detected in staged changes. Fork development is English-only." ;;
    *) echo "pre-commit: WARNING: LAW-16 checker could not run (python exit $rc); gate skipped this run." >&2 ;;
  esac
fi

# ---------- Gate 8: LAW-12 - resurrect this hook on every clone ----------
# .git/hooks/ does not propagate through clone. The canonical hook is in
# .git-hooks/ (tracked); when a fresh machine has no core.hooksPath yet,
# this self-installs it so the gates survive every clone unattended.
if [ "$(git config --get core.hooksPath)" != ".git-hooks" ]; then
  git config core.hooksPath .git-hooks
  echo "pre-commit: LAW-12 installed: core.hooksPath -> .git-hooks (auto-resurrect on clone)" >&2
fi

exit 0
